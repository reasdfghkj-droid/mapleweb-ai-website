{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "mapleweb-ai-agents-staging",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-17",
  "workers_dev": true,
  "assets": {
    "directory": "../public",
    "binding": "ASSETS",
    "run_worker_first": ["/health", "/api/*"]
  },
  "observability": { "enabled": true }
}
