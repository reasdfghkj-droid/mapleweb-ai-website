{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mapleweb-ai-private-manager",
  "main": "workers/manager.mjs",
  "compatibility_date": "2026-11-17",
  "workers_dev": false,
  "ai": { "binding": "AI" },
  "assets": {
    "directory": "./manager-ui",
    "binding": "ASSETS",
    "run_worker_first": ["/*"]
  },
  "vars": {
    "MANAGER_API_APPROVED": "false",
    "AI_DRAFTS_APPROVED": "false",
    "AI_DEVELOPER_APPROVED": "false",
    "AUTO_AGENT_BATCH_APPROVED": "false",
    "STRIPE_TEST_DRAFTS_APPROVED": "false",
    "PRIVATE_PREVIEWS_APPROVED": "false",
    "AUTO_BUILD_HANDOFF_APPROVED": "false",
    "PUBLIC_SITE_ORIGIN": "https://mapleweb-ai-website.reasdfghkj.workers.dev"
  }
}
