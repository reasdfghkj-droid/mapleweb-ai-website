{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mapleweb-ai",
  "main": "workers/developer.mjs",
  "compatibility_date": "2026-11-17",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/health",
      "/api/*"
    ],
    "not_found_handling": "404-page"
  },
  "vars": {
    "SUBMISSIONS_APPROVED": "false",
    "RETENTION_DAYS": "30"
  }
}
