{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mapleweb-ai",
  "main": "workers/developer.mjs",
  "compatibility_date": "2026-11-17",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/health",
      "/api/*",
      "/preview/*",
      "/review/*"
    ],
    "not_found_handling": "404-page"
  },
  "vars": {
    "SUBMISSIONS_APPROVED": "false",
    "RETENTION_DAYS": "30",
    "PRIVATE_PREVIEWS_APPROVED": "false",
    "AUTO_BUILD_HANDOFF_APPROVED": "false",
    "CUSTOMER_PORTAL_APPROVED": "false",
    "STRIPE_LIVE_WEBHOOKS_APPROVED": "false",
    "STRIPE_LIVE_ACCOUNT_VERIFIED": "false",
    "STRIPE_LIVE_BANK_CONFIRMED": "false",
    "STRIPE_LIVE_TAX_REVIEWED": "false"
  }
}
